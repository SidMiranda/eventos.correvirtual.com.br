APP_NAME="Corre Virtual"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# Precisa bater com POSTGRES_DB / POSTGRES_USER / POSTGRES_PASSWORD do .env
# na raiz do repo (é o mesmo container de banco visto pelos dois lados).
# Veja docs/runbook.md.
DB_CONNECTION=pgsql
DB_HOST=db
DB_PORT=5432
DB_DATABASE=corre_virtual
DB_USERNAME=corre_virtual
DB_PASSWORD=corre_virtual_dev

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

# Token de acesso da API do Mercado Pago (Pix). Veja docs/specs/pagamentos-pix.md.
MERCADOPAGO_ACCESS_TOKEN=
# Client ID/Secret da aplicação (fluxo OAuth do Mercado Pago) — não usados em código
# hoje, só guardados pra referência caso precisem no futuro.
MERCADOPAGO_CLIENT_ID=
MERCADOPAGO_CLIENT_SECRET=
# Secret do webhook configurado no painel do Mercado Pago para esta URL de notificação.
# Sem isso, /api/webhooks/mercadopago rejeita toda notificação (falha fechada). Veja docs/runbook.md.
MERCADOPAGO_WEBHOOK_SECRET=

# TEMPORÁRIO — teste, reverter quando o Sidney liberar (BUG-001, ver docs/backlog.md).
# Com true, toda cobrança Pix sai no valor de MERCADOPAGO_TEST_PRICE_VALUE, não no preço
# real do kit. Ver PixController::generatePix.

# Usada só pelo comando offline `php artisan images:generate-gemini` (Home v2 — ver docs/specs/frontend-publico.md).
# Nunca é chamada em runtime pela aplicação.
GEMINI_API_KEY=

# Vazio = imagens servidas do disco do container (public/images).
# Preenchido = servidas do CDN. Prefixo completo até "publico", sem barra no fim.
# Ex.: https://cdn.correvirtual.com.br/publico
# Ver docs/specs/armazenamento-r2.md
ARQUIVOS_BASE_URL=

# Cloudflare R2 — disco dos arquivos enviados pelo painel.
# Em desenvolvimento use o bucket -dev: dev e producao compartilhavam o mesmo
# bucket e uma carga de teste sobrescreveu a arte de producao (2026-08-29).
R2_ENDPOINT=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=correvirtual-arquivos-dev
R2_BUCKET_PRIVADO=correvirtual-privado

# Modelo de card na home: v2 = só o cartaz do evento (padrão);
# v1 = arte + data + nome + local em texto. Ver config/aparencia.php
CARD_DE_EVENTO=v2

# WhatsApp do botão flutuante do site. Só dígitos, com país e DDD (formato do
# wa.me). Vazio esconde o botão. Ver config/contato.php
WHATSAPP_NUMERO=5519997061361
WHATSAPP_MENSAGEM="Olá, vim do site do Corre Virtual"

# Cobrança com split (ADR 0008): a aplicação Mercado Pago da PLATAFORMA.
# O organizador conecta a conta dele em /admin/cobranca (OAuth).
# O redirect_uri precisa ser exatamente o cadastrado na aplicação.
MERCADOPAGO_APP_CLIENT_ID=
MERCADOPAGO_APP_CLIENT_SECRET=
MERCADOPAGO_OAUTH_REDIRECT_URI=https://admin.correvirtual.com.br/mercadopago/oauth/retorno
MERCADOPAGO_APP_WEBHOOK_SECRET=
# Quem recebe o alerta quando a cobrança para (token não renovou, Pix falhou).
ALERTA_COBRANCA_EMAIL=
